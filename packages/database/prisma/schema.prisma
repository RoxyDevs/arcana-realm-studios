// Arcana Realm Studios — core data model.
// Feature-first: models are grouped by module (Identity, Billing, Music, Guardian)
// but live in one schema because they share foreign keys and a single transaction boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & Access (RBAC)
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

model User {
  id            String    @id @default(cuid())
  discordId     String    @unique
  username      String
  email         String?   @unique
  avatarUrl     String?
  roles         Role[]    @default([MEMBER])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens RefreshToken[]
  wallet        Wallet?
  subscriptions Subscription[]
  ownedRooms    Room[]           @relation("RoomOwner")
  playlists     Playlist[]
  queueRequests MusicQueueItem[]
  uploadedTracks Track[]         @relation("UploadedTracks")
  reviewedReports GuardianReport[] @relation("ReportReviewer")
  auditLogs     AuditLog[]
  grantedLicenses BotLicense[]     @relation("LicenseGrantedBy")
  grantedGuardianLicenses GuardianLicense[] @relation("GuardianLicenseGrantedBy")
  liveSessions  LiveSession[]
  roomMemberships RoomMember[]
  issuedRoomBans RoomBan[] @relation("RoomBanIssuedBy")

  @@map("users")
}

// One-party consent, own-service token logging (see .env / security policy):
// this table only ever stores hashes of tokens issued by Arcana itself.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  issuedIp   String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Rooms — a Room is a community space owned/hosted by a User.
// `imvuRoomId` is an opaque external reference supplied by the (adapter-isolated)
// IMVU integration; Arcana never assumes a documented IMVU room API exists.
//
// Ownership is proven the same way Vusic's "VALIDAR SALA" flow does it: we
// generate a one-time `verificationToken`, the owner pastes it into their
// room's IMVU description, and an adapter-isolated checker confirms it's
// there before the room moves from PENDING to VERIFIED. Every Room a user
// binds goes through this same flow — nothing here is hardcoded to one room.
// ---------------------------------------------------------------------------

enum RoomVerificationStatus {
  PENDING
  VERIFIED
}

model Room {
  id                 String                 @id @default(cuid())
  ownerId            String
  imvuRoomId         String                 @unique
  name               String
  verificationToken  String                 @unique
  verificationStatus RoomVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  streamKey          String                 @unique
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  owner             User               @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  musicQueue        MusicQueueItem[]
  botLicenses       BotLicense[]
  guardianLicenses  GuardianLicense[]
  guardianSettings  GuardianSettings?
  guardianReports   GuardianReport[]
  liveSessions      LiveSession[]
  members           RoomMember[]
  imvuBotCredential ImvuBotCredential?
  bans              RoomBan[]

  @@index([ownerId])
  @@map("rooms")
}

// Self-service roster: anyone with an Arcana account who has the room's link
// can tag themselves with a free-text role for that room — roleplay
// communities (families, clans, fantasy kingdoms) use this for things like
// "Femenino"/"Masculino" or a custom in-character title. Distinct from
// Room.ownerId (who *administers* the room on Arcana) — a member here is
// just someone who showed up and set a tag, no ownership implied.
model RoomMember {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  roleTag   String?
  // Self-reported, same trust level as roleTag — NOT a verified identity
  // link. Lets an incoming ImvuRoomChatMessage.senderDisplayName (see
  // imvu-bot's domain port) be matched back to this roster row so bot
  // responses can be conscious of a chatter's roleTag. Nothing enforces
  // that the person actually owns this IMVU display name.
  imvuDisplayName String?
  joinedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_members")
}

// ---------------------------------------------------------------------------
// Room bans — !ban/!kick/!unban from the room-bot's chat commands (see
// ChatCommandRouter). `imvu.js`'s User.kick() only removes someone from the
// room *right now*; IMVU has no persistent-ban primitive exposed through it.
// This table is what makes a ban actually stick: BotSessionService listens
// for room-join events and re-kicks anyone on this list the moment they try
// to come back, on every single join, for as long as the row exists.
// ---------------------------------------------------------------------------

model RoomBan {
  id              String   @id @default(cuid())
  roomId          String
  // Matching is by IMVU display name, not a stable id — the same trust
  // level as RoomMember.imvuDisplayName, and for the same reason: nothing
  // in what's actually available (see imvu-bot/README.md) hands back a
  // durable identity to key this on instead. A determined target could
  // evade this by changing their display name; this stops casual
  // re-entry, not a motivated bad actor.
  imvuDisplayName String
  reason          String?
  bannedById      String
  createdAt       DateTime @default(now())

  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bannedBy User @relation("RoomBanIssuedBy", fields: [bannedById], references: [id], onDelete: Cascade)

  @@unique([roomId, imvuDisplayName])
  @@index([roomId])
  @@map("room_bans")
}

// ---------------------------------------------------------------------------
// Live DJ / mic broadcasting — a room owner's own live audio (mic, DJ set,
// podcast) takes over the Icecast mount from AutoDJ while connected, then
// falls back to the queue automatically once the session ends. The harbor
// source password is per-session and short-lived on purpose: `Room.streamKey`
// is a stable public-facing identifier, but source credentials should never
// be — see StreamingInternalService's live-auth check, which validates
// against `endedAt IS NULL` on every harbor connection attempt.
// ---------------------------------------------------------------------------

model LiveSession {
  id            String    @id @default(cuid())
  roomId        String
  startedById   String
  sourcePassword String   @unique
  startedAt     DateTime  @default(now())
  endedAt       DateTime?

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startedBy User @relation(fields: [startedById], references: [id], onDelete: Cascade)

  @@index([roomId, endedAt])
  @@map("live_sessions")
}

// ---------------------------------------------------------------------------
// Billing (Arcana Dashboard) — token/credit wallet + Stripe subscriptions.
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  FREE
  PLUS
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum TransactionType {
  PURCHASE
  SUBSCRIPTION_RENEWAL
  CONSUMPTION
  REFUND
  MANUAL_ADJUSTMENT
}

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  creditBalance Int      @default(0)
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id                    String          @id @default(cuid())
  walletId              String
  type                  TransactionType
  amount                Int
  stripePaymentIntentId String?         @unique
  metadata              Json?
  createdAt             DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("transactions")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  // Set only when this subscription started via a Stripe trial — null once it converts to a normal paid period or if no trial was granted.
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

// One row per successful trial grant, keyed by both the granting user and the
// IP address the checkout was created from. A card is still required by
// Stripe for every trial (see BillingService.createSubscriptionCheckout), so
// this exists purely to stop the *same person* from cycling Discord accounts
// to keep re-claiming the 3-day trial — the checkout flow refuses a second
// trial from either a userId or an ipAddress that already has a row here.
model TrialClaim {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String
  tier      SubscriptionTier
  claimedAt DateTime @default(now())

  @@index([userId])
  @@index([ipAddress])
  @@map("trial_claims")
}

// Time-boxed bot access for a Room — the "1 day / 1 week / 1 month / 3 months /
// 1 year" plans. Bought with wallet credits (self-service) or granted by an
// ADMIN after confirming an out-of-band payment (PayPal.me, in-game VCoin gift) —
// either way it goes through the same credit ledger, so every grant is auditable.
enum BotLicensePlan {
  DAY_1
  WEEK_1
  MONTH_1
  MONTH_3
  YEAR_1
}

enum BotLicenseSource {
  CREDIT_PURCHASE
  MANUAL_GRANT
}

model BotLicense {
  id          String            @id @default(cuid())
  roomId      String
  plan        BotLicensePlan
  source      BotLicenseSource
  creditsCost Int
  startsAt    DateTime
  expiresAt   DateTime
  grantedById String?
  createdAt   DateTime          @default(now())

  room      Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("LicenseGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([roomId, expiresAt])
  @@map("bot_licenses")
}

// The room owner's imvu.js.org bot token — see apps/api/src/modules/imvu-bot/README.md
// for what this actually is (NOT an IMVU-issued credential; a token from an
// unaffiliated third-party relay) and why it's encrypted at rest instead of
// stored plainly like Room.streamKey. One per room, replaced wholesale on
// re-entry rather than versioned.
model ImvuBotCredential {
  id             String   @id @default(cuid())
  roomId         String   @unique
  encryptedToken String
  iv             String
  authTag        String
  // Where the bot stands/sits, sent once via imvu.js's update_seat() right
  // after login — confirmed real (lib/imvu.js's `IMVU.seat` /
  // `update_seat()`), unlike `outfit`, which the library accepts in its
  // constructor but never actually uses anywhere (verified by reading the
  // full source — dead code, not wired to anything). There is no
  // equivalent for appearance: whatever the bot's underlying IMVU account
  // is wearing (set the normal way, through IMVU itself) is what shows up.
  seat           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("imvu_bot_credentials")
}

// Time-boxed Guardian (moderation) access for a Room — deliberately independent
// of BotLicense: a room can run AutoDJ without Guardian, Guardian without
// AutoDJ, or both. Same credit-ledger pattern (self-service purchase or
// audited manual grant) as BotLicense; Guardian settings/reports are only
// served for a room while this is active (see GuardianLicenseService.isActive).
enum GuardianLicensePlan {
  DAY_1
  WEEK_1
  MONTH_1
  MONTH_3
  YEAR_1
}

enum GuardianLicenseSource {
  CREDIT_PURCHASE
  MANUAL_GRANT
}

model GuardianLicense {
  id          String                @id @default(cuid())
  roomId      String
  plan        GuardianLicensePlan
  source      GuardianLicenseSource
  creditsCost Int
  startsAt    DateTime
  expiresAt   DateTime
  grantedById String?
  createdAt   DateTime              @default(now())

  room      Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("GuardianLicenseGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([roomId, expiresAt])
  @@map("guardian_licenses")
}

// ---------------------------------------------------------------------------
// Arcana Music — playlists, tracks, per-room queue.
// ---------------------------------------------------------------------------

enum TrackSource {
  SPOTIFY
  YOUTUBE
  UPLOAD
  // Creative-Commons-licensed catalog from Jamendo's public API — unlike
  // SPOTIFY/YOUTUBE (metadata-only, never streamed, see Track.fileUrl below),
  // JAMENDO rows *do* get a real fileUrl: Jamendo's own licensing explicitly
  // permits streaming/downloading the audio, so this is the one external
  // source AutoDJ is allowed to actually play alongside room uploads.
  JAMENDO
}

model Track {
  id           String      @id @default(cuid())
  source       TrackSource
  externalId   String
  title        String
  artist       String?
  durationSec  Int
  thumbnailUrl String?
  createdAt    DateTime    @default(now())

  // Only set when source = UPLOAD — the room's own licensed/owned audio,
  // stored in object storage (Cloudflare R2), never a copy of a
  // Spotify/YouTube stream. genreTags feeds the AI playlist matcher.
  uploadedById String?
  storageKey   String?
  fileUrl      String?
  genreTags    String[]    @default([])

  uploadedBy User?             @relation("UploadedTracks", fields: [uploadedById], references: [id], onDelete: SetNull)
  playlists  PlaylistTrack[]
  queueItems MusicQueueItem[]

  @@unique([source, externalId])
  @@map("tracks")
}

model Playlist {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@index([ownerId])
  @@map("playlists")
}

model PlaylistTrack {
  playlistId String
  trackId    String
  position   Int

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@map("playlist_tracks")
}

model MusicQueueItem {
  id            String    @id @default(cuid())
  roomId        String
  trackId       String
  requestedById String
  position      Int
  playedAt      DateTime?
  createdAt     DateTime  @default(now())

  room        Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  track       Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  requestedBy User  @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([roomId, position])
  @@map("music_queue_items")
}

// ---------------------------------------------------------------------------
// Arcana Guardian — consent-scoped moderation: reports are about incidents
// that happened inside a room the reporter hosts/moderates, never third-party
// surveillance. `subjectIdentifier` is the accused party's public IMVU handle,
// not a tracked account — Arcana never resolves it to a live location/session.
// ---------------------------------------------------------------------------

enum GuardianReportCategory {
  HARASSMENT
  SPAM
  RAID
  HATE_SPEECH
  BAN_EVASION
  OTHER
}

enum GuardianReportStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

model GuardianSettings {
  id                 String  @id @default(cuid())
  roomId             String  @unique
  antiSpamEnabled    Boolean @default(true)
  antiRaidEnabled    Boolean @default(true)
  autoModEnabled     Boolean @default(true)
  sharedBlacklistOptIn Boolean @default(false)
  updatedAt          DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("guardian_settings")
}

model GuardianReport {
  id                String                  @id @default(cuid())
  roomId            String
  subjectIdentifier String
  category          GuardianReportCategory
  description       String
  evidenceUrl       String?
  status            GuardianReportStatus    @default(PENDING)
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime                @default(now())

  room       Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([subjectIdentifier])
  @@map("guardian_reports")
}

// Aggregated, opt-in community reputation — derived only from confirmed
// GuardianReports across rooms that opted into the shared network.
model ReputationScore {
  id                String   @id @default(cuid())
  subjectIdentifier String   @unique
  score             Int      @default(0)
  confirmedReports  Int      @default(0)
  lastUpdatedAt     DateTime @updatedAt

  @@map("reputation_scores")
}
