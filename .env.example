# --- Database ---
DATABASE_URL="postgresql://arcana:arcana@localhost:5432/arcana_realm?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_CALLBACK_URL="http://localhost:4000/auth/discord/callback"

# Comma-separated Discord user IDs that get the OWNER role the moment they
# first log in — solves the bootstrap problem (nobody has admin rights yet).
# Get your own Discord ID via Discord > User Settings > Advanced > Developer
# Mode, then right-click your name > "Copy User ID".
BOOTSTRAP_OWNER_DISCORD_IDS=""

# --- Billing (Arcana Dashboard) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PLUS_MONTHLY=""
STRIPE_PRICE_PREMIUM_MONTHLY=""

# --- Music integrations (Arcana Music) ---
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
YOUTUBE_API_KEY=""

# --- Rooms (IMVU room binding) ---
# Not a documented IMVU endpoint. Leave unset until the real request behind
# room-description verification (Vusic's "VALIDAR SALA") is confirmed — see
# apps/api/src/modules/rooms/infrastructure/imvu-room-page.verifier.ts.
# "{roomId}" is substituted with the parsed "<clientId>-<roomId>" slug.
IMVU_ROOM_PAGE_URL_TEMPLATE=""

# Base URL of the Icecast/HLS server that serves each room's AutoDJ stream.
STREAMING_BASE_URL="https://stream.arcanarealmstudios.com"

# --- App ---
API_PORT=4000
WEB_URL="http://localhost:3000"
NODE_ENV="development"
