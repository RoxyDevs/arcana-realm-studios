# --- Database ---
DATABASE_URL="postgresql://arcana:arcana@localhost:5432/arcana_realm?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_CALLBACK_URL="http://localhost:4000/auth/discord/callback"

# Comma-separated Discord user IDs that get the OWNER role the moment they
# first log in — solves the bootstrap problem (nobody has admin rights yet).
# Get your own Discord ID via Discord > User Settings > Advanced > Developer
# Mode, then right-click your name > "Copy User ID".
BOOTSTRAP_OWNER_DISCORD_IDS=""

# --- Billing (Arcana Dashboard) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PLUS_MONTHLY=""
STRIPE_PRICE_PREMIUM_MONTHLY=""

# --- Music integrations (Arcana Music) ---
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
YOUTUBE_API_KEY=""

# --- Rooms (IMVU room binding) ---
# Not an officially documented IMVU endpoint, but confirmed public/unauthenticated —
# leave unset to use the built-in default (https://api.imvu.com/room/room-{roomId}).
# Only set this if IMVU changes the shape and you've confirmed a replacement — see
# apps/api/src/modules/rooms/infrastructure/imvu-room-api.verifier.ts.
IMVU_ROOM_PAGE_URL_TEMPLATE=""

# Base URL of the Icecast/HLS server that serves each room's AutoDJ stream —
# set this to the apps/streaming service's public URL once deployed.
STREAMING_BASE_URL="https://stream.arcanarealmstudios.com"
# Shared secret the streaming service authenticates with against
# /internal/streaming/* — must exactly match that service's own env var.
STREAMING_INTERNAL_TOKEN=""
# Port Liquidsoap's shared input.harbor listener runs on for live mic/DJ
# broadcasts — must match that service's LIQUIDSOAP_HARBOR_PORT.
STREAMING_HARBOR_PORT="8006"

# --- Object storage (Cloudflare R2 — S3-compatible, for uploaded tracks) ---
# Only ever the room owner's own licensed/uploaded audio — never a copy of a
# Spotify/YouTube stream. See apps/api/src/common/infrastructure/r2-object.storage.ts.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# The bucket's Public Development URL (or a custom domain), e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=""

# --- IMVU room bot (imvu.js.org — unaffiliated third party, NOT an IMVU API) ---
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts
# each room's imvu.js.org bot token at rest. See
# apps/api/src/modules/imvu-bot/README.md before enabling this in production.
IMVU_BOT_CREDENTIAL_ENCRYPTION_KEY=""

# --- App ---
API_PORT=4000
WEB_URL="http://localhost:3000"
NODE_ENV="development"
